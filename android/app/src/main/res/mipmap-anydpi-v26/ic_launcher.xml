<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+): the launcher masks the foreground into
     whatever shape the device theme uses, over the Pick1 ink background. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/p1_ink" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
